# Copy to .env (./start.sh does this on first run) and fill in. .env is gitignored; never commit it.
# Wrap values containing spaces or $ in single quotes.

# Anthropic Console → your glosor workspace → API keys
ANTHROPIC_API_KEY=

# Cloudflare dashboard → Turnstile → glosor widget. The site key is public; the secret key is not.
TURNSTILE_SITE_KEY=0x4AAAAAAE-9NUN7el3XsX8t
TURNSTILE_SECRET_KEY=

# Shared password visitors enter once per session
ACCESS_PASSWORD=

# Stop grading once today's estimated spend (UTC) reaches this
DAILY_BUDGET_USD=2

# Signs session cookies so they survive restarts. ./start.sh fills this in.
SESSION_SECRET=

# Optional: name of a Cloudflare Tunnel to serve through (see README → Hosting from home)
TUNNEL_NAME=

# Optional overrides
# PORT=5173
# RATE_LIMIT=60
# MODEL=claude-sonnet-5-5
# EFFORT=medium
